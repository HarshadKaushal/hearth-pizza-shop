generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IngredientCategory {
  CRUST
  SAUCE
  CHEESE
  TOPPING
}

enum PizzaSize {
  SMALL
  MEDIUM
  LARGE
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Ingredient {
  id          String             @id @default(cuid())
  name        String             @unique
  description String
  category    IngredientCategory
  priceCents  Int
  available   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  snapshots   OrderPizzaIngredient[]  
}

model Order {
  id           String          @id @default(cuid())
  customerName String
  phone        String
  fulfillment  FulfillmentType
  address      String?
  notes        String?
  status       OrderStatus     @default(RECEIVED)
  totalCents   Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  pizzas       OrderPizza[]

  @@index([userId])
}

model OrderPizza {
  id             String                 @id @default(cuid())
  orderId        String
  order          Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  size           PizzaSize
  label          String
  baseCents      Int    
  lineTotalCents Int
  ingredients    OrderPizzaIngredient[]
}

model OrderPizzaIngredient {
  id           String             @id @default(cuid())
  orderPizzaId String
  orderPizza   OrderPizza         @relation(fields: [orderPizzaId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient         @relation(fields: [ingredientId], references: [id])
  name         String
  category     IngredientCategory
  priceCents   Int
}
