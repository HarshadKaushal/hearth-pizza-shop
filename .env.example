# Copy to .env at the repo root when running tools from the host.
# The API reads DATABASE_URL from backend/.env (see backend/.env.example once that app exists).

POSTGRES_USER=hearth
POSTGRES_PASSWORD=hearth
POSTGRES_DB=hearth
DATABASE_URL=postgresql://hearth:hearth@localhost:5432/hearth?schema=public
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
